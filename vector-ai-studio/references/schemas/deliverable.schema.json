{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector-ai-studio.local/schemas/deliverable.schema.json",
  "title": "vector-ai-studio delivery manifest",
  "description": "What was actually measured in the delivered .ai, plus the warnings a client must see. Every value here is observed from the file's own bytes; nothing is a promise. Fields added 2026-11-08 (engine, engine_version, export_steps, source_probe, tool_warnings, observed.color_mode/layers/artboard_pt) are declared here because the schema had drifted from what the script actually emits; a contract that omits real fields is not a contract.",
  "type": "object",
  "required": [
    "schema",
    "file",
    "profile",
    "save_options",
    "observed",
    "engine",
    "warnings",
    "verify_yourself"
  ],
  "properties": {
    "schema": {
      "const": "vector-ai-studio/deliverable-v1"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "screen",
        "print",
        "handoff"
      ]
    },
    "save_options": {
      "type": "object",
      "required": [
        "pdf_compatible",
        "embed_icc",
        "cmyk",
        "bleed_mm"
      ],
      "properties": {
        "compatibility": {
          "type": "string"
        },
        "pdf_compatible": {
          "type": "boolean"
        },
        "embed_icc": {
          "type": "boolean"
        },
        "cmyk": {
          "type": "boolean"
        },
        "bleed_mm": {
          "type": "number",
          "minimum": 0
        },
        "bleed_pt": {
          "type": "number",
          "minimum": 0
        },
        "layers_from_groups": {
          "type": "boolean"
        },
        "pdf_standard": {
          "type": "string",
          "description": "vectorcraft-only: none | pdfX1a | pdfX3 | pdfX4"
        },
        "color_mode": {
          "type": "string",
          "description": "what this engine was asked to convert to"
        },
        "output_intent": {
          "type": [
            "string",
            "null"
          ],
          "description": "read back from the print PDF's /OutputConditionIdentifier when it exists, so this one entry is an observed value, not a request"
        },
        "output_intent_requested": {
          "type": [
            "string",
            "null"
          ],
          "description": "the profile name that was asked for; null/absent when none was"
        },
        "printers_marks": {
          "type": "boolean",
          "description": "whether crop/registration marks were requested for the print master"
        }
      }
    },
    "observed": {
      "type": "object",
      "required": [
        "bytes",
        "sha256",
        "has_ai_private",
        "pdf_compatible"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdf_compatible": {
          "type": "boolean"
        },
        "pdf_header": {
          "type": "string"
        },
        "has_ai_private": {
          "type": "boolean"
        },
        "has_aiprivatedata1_marker": {
          "type": "boolean",
          "description": "same value as has_ai_private; names the byte fact rather than a licensing claim"
        },
        "fonts_embedded": {
          "type": "integer",
          "minimum": 0,
          "description": "embedded font programs counted by /FontFile, /FontFile2, /FontFile3 without prefix double-counting"
        },
        "output_condition": {
          "type": [
            "string",
            "null"
          ],
          "description": "/OutputConditionIdentifier read back from the print PDF"
        },
        "device_rgb": {
          "type": "integer",
          "minimum": 0
        },
        "device_cmyk": {
          "type": "integer",
          "minimum": 0
        },
        "output_intent": {
          "type": "integer",
          "minimum": 0
        },
        "iccbased": {
          "type": "integer",
          "minimum": 0
        },
        "fonts": {
          "type": "integer",
          "minimum": 0,
          "description": "embedded font programs counted by /FontFile, /FontFile2, /FontFile3; one Type0 font counts once, not once per /BaseFont entry"
        },
        "images": {
          "type": "integer",
          "minimum": 0
        },
        "artboard_mm": {
          "type": [
            "array",
            "null"
          ]
        },
        "content_ops": {
          "type": [
            "object",
            "null"
          ],
          "description": "页面内容流（/Contents 引用与 /Subtype /Form）里的颜色算子计数；ICC、字体程序、CMap 等二进制流不计入，内联图像 BI…ID…EI 之间的像素字节不计入。解码数为 0 时为 null（未测），不是全 0（测过且为零）",
          "properties": {
            "rg": {
              "type": "integer",
              "minimum": 0
            },
            "RG": {
              "type": "integer",
              "minimum": 0
            },
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "K": {
              "type": "integer",
              "minimum": 0
            },
            "g": {
              "type": "integer",
              "minimum": 0
            },
            "G": {
              "type": "integer",
              "minimum": 0
            },
            "sc": {
              "type": "integer",
              "minimum": 0
            },
            "SC": {
              "type": "integer",
              "minimum": 0
            },
            "scn": {
              "type": "integer",
              "minimum": 0
            },
            "SCN": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "content_streams": {
          "type": "object",
          "description": "scope is the page /Contents refs plus /Subtype /Form streams; ICC profiles, font programs and CMaps are excluded. Illustrator and VectorCraft write this under observed; the Craft engine writes it under observed.print_pdf instead",
          "properties": {
            "objects": {
              "type": "integer",
              "minimum": 0,
              "description": "page-level stream objects actually found in the file"
            },
            "refs": {
              "type": "integer",
              "minimum": 0,
              "description": "page /Contents references; exceeds objects when a reference points at an object the reader never unpacked"
            },
            "streams": {
              "type": "integer",
              "minimum": 0,
              "description": "deprecated alias of objects, kept for older manifests"
            },
            "decoded": {
              "type": "integer",
              "minimum": 0,
              "description": "streams whose operators were actually counted; decoded < objects means part of the page was not measured"
            },
            "scope": {
              "type": "string"
            }
          }
        },
        "artboard_pt": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "layers": {
          "type": "integer",
          "minimum": 0,
          "description": "optional-content groups counted from the file bytes"
        },
        "color_mode": {
          "type": "string",
          "description": "verdict from the content-stream operators (cmyk|rgb|mixed|declared-only|unknown), not from the resource dictionary"
        },
        "paths": {
          "type": "integer",
          "minimum": 0,
          "description": "vectorcraft-only: Path + Compound Path objects reported by `info` after reopening the .ai"
        },
        "artboard_matches_viewBox": {
          "type": "boolean",
          "description": "vectorcraft-only: H1 half-clause, the same comparison lib_pdf and aggregate_log make from the structure readback"
        },
        "print_pdf": {
          "type": [
            "object",
            "null"
          ],
          "description": "vectorcraft-only: facts read from the print master PDF; null/absent when no PDF was asked for",
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "pdf_header": {
              "type": "string"
            },
            "GTS_PDFXVersion": {
              "type": "integer",
              "minimum": 0
            },
            "OutputIntent": {
              "type": "integer",
              "minimum": 0
            },
            "OutputCondition": {
              "type": "integer",
              "minimum": 0
            },
            "Trapped": {
              "type": "integer",
              "minimum": 0
            },
            "TrimBox": {
              "type": "integer",
              "minimum": 0
            },
            "BleedBox": {
              "type": "integer",
              "minimum": 0
            },
            "MediaBox": {
              "type": "integer",
              "minimum": 0
            },
            "DeviceCMYK": {
              "type": "integer",
              "minimum": 0
            },
            "DeviceRGB": {
              "type": "integer",
              "minimum": 0
            },
            "ICCBased": {
              "type": "integer",
              "minimum": 0
            },
            "trimbox_rect": {
              "type": [
                "string",
                "null"
              ]
            },
            "bleedbox_rect": {
              "type": [
                "string",
                "null"
              ]
            },
            "mediabox_rect": {
              "type": [
                "string",
                "null"
              ]
            },
            "gts_pdfx_value": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_condition": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_intent_objects": {
              "type": "integer",
              "minimum": 0
            },
            "streams_decoded": {
              "type": "integer",
              "minimum": 0,
              "description": "deprecated alias of content_streams.decoded, kept for older manifests"
            },
            "content_ops_scope": {
              "type": "string"
            },
            "content_ops": {
              "type": [
                "object",
                "null"
              ],
              "description": "同 observed.content_ops；解码数为 0 时为 null（未测），不是全 0",
              "properties": {
                "rg": {
                  "type": "integer",
                  "minimum": 0
                },
                "RG": {
                  "type": "integer",
                  "minimum": 0
                },
                "k": {
                  "type": "integer",
                  "minimum": 0
                },
                "K": {
                  "type": "integer",
                  "minimum": 0
                },
                "g": {
                  "type": "integer",
                  "minimum": 0
                },
                "G": {
                  "type": "integer",
                  "minimum": 0
                },
                "sc": {
                  "type": "integer",
                  "minimum": 0
                },
                "SC": {
                  "type": "integer",
                  "minimum": 0
                },
                "scn": {
                  "type": "integer",
                  "minimum": 0
                },
                "SCN": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content_streams": {
              "type": "object",
              "properties": {
                "objects": {
                  "type": "integer",
                  "minimum": 0
                },
                "refs": {
                  "type": "integer",
                  "minimum": 0
                },
                "decoded": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "description": "structural readback; keys mirror the fields the craft landers measure",
      "properties": {
        "open_paths": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reopen_paths": {
          "type": [
            "integer",
            "null"
          ]
        },
        "layers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reopen_layers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raster": {
          "type": [
            "integer",
            "null"
          ]
        },
        "placed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "artboard": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 200x200"
        },
        "viewBox": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 0_0_200_200"
        },
        "trimmarks_ink": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "engine_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "free-form per-engine notes carried from the lander; empty when the engine reports none"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify_yourself": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "trimmarks_ink": {
      "type": [
        "string",
        "null"
      ],
      "description": "ink of the crop marks; null where the engine draws none"
    },
    "engine": {
      "const": "vectorcraft",
      "description": "which engine produced the file (r45: VectorCraft is the only engine)"
    },
    "engine_version": {
      "type": "string",
      "description": "reported by the tool itself, never hardcoded"
    },
    "export_steps": {
      "type": "array",
      "description": "raw per-step output from the vectorcraft CLI, kept verbatim"
    },
    "source_probe": {
      "type": [
        "object",
        "null"
      ],
      "description": "what the engine said about the source before converting; null where the engine has no such phase",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "rc": {
          "type": "integer",
          "description": "present only when the probe failed; the CLI exit code"
        },
        "fonts": {
          "type": "array",
          "description": "per-font answer from the engine, carried verbatim"
        },
        "import_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objects": {
          "type": [
            "integer",
            "null"
          ]
        },
        "color_mode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tool_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "warnings the toolchain saw, kept as each producer wrote them. Two writers: land_vc records export-engine warnings, one entry per distinct string in first-seen order; lib_pdf records the PDF reader's entries, each prefixed with 'pdf reader: '. land_vc does not forward the reader's entry, so a vectorcraft manifest has no reader line"
    },
    "h1_pass": {
      "type": "boolean",
      "description": "vectorcraft-only top-level copy of the H1 verdict; land_craft writes the same flag inside structure_readback.json"
    }
  }
}
