{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector-ai-studio.local/schemas/deliverable.schema.json",
  "title": "vector-ai-studio delivery manifest",
  "description": "What was actually measured in the delivered .ai, plus the warnings a client must see. Every value here is observed from the file's own bytes; nothing is a promise. Fields added 2026-11-08 (engine, engine_version, export_steps, source_probe, tool_warnings, observed.color_mode/layers/artboard_pt) are declared here because the schema had drifted from what the script actually emits; a contract that omits real fields is not a contract.",
  "type": "object",
  "required": [
    "schema",
    "file",
    "profile",
    "save_options",
    "observed",
    "warnings",
    "verify_yourself"
  ],
  "properties": {
    "schema": {
      "const": "vector-ai-studio/deliverable-v1"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "screen",
        "print",
        "handoff"
      ]
    },
    "save_options": {
      "type": "object",
      "required": [
        "pdf_compatible",
        "embed_icc",
        "cmyk",
        "bleed_mm"
      ],
      "properties": {
        "compatibility": {
          "type": "string"
        },
        "pdf_compatible": {
          "type": "boolean"
        },
        "embed_icc": {
          "type": "boolean"
        },
        "cmyk": {
          "type": "boolean"
        },
        "bleed_mm": {
          "type": "number",
          "minimum": 0
        },
        "bleed_pt": {
          "type": "number",
          "minimum": 0
        },
        "layers_from_groups": {
          "type": "boolean"
        }
      }
    },
    "observed": {
      "type": "object",
      "required": [
        "bytes",
        "sha256",
        "has_ai_private",
        "pdf_compatible"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdf_compatible": {
          "type": "boolean"
        },
        "pdf_header": {
          "type": "string"
        },
        "has_ai_private": {
          "type": "boolean"
        },
        "has_aiprivatedata1_marker": {
          "type": "boolean",
          "description": "same value as has_ai_private; names the byte fact rather than a licensing claim"
        },
        "fonts_embedded": {
          "type": "integer",
          "minimum": 0,
          "description": "embedded font programs counted by /FontFile, /FontFile2, /FontFile3 without prefix double-counting"
        },
        "output_condition": {
          "type": [
            "string",
            "null"
          ],
          "description": "/OutputConditionIdentifier read back from the print PDF"
        },
        "device_rgb": {
          "type": "integer",
          "minimum": 0
        },
        "device_cmyk": {
          "type": "integer",
          "minimum": 0
        },
        "output_intent": {
          "type": "integer",
          "minimum": 0
        },
        "iccbased": {
          "type": "integer",
          "minimum": 0
        },
        "fonts": {
          "type": "integer",
          "minimum": 0
        },
        "images": {
          "type": "integer",
          "minimum": 0
        },
        "artboard_mm": {
          "type": [
            "array",
            "null"
          ]
        },
        "content_ops": {
          "type": [
            "object",
            "null"
          ],
          "description": "页面内容流（/Contents 引用与 /Subtype /Form）里的颜色算子计数；ICC、字体程序、CMap 等二进制流不计入",
          "properties": {
            "rg": {
              "type": "integer",
              "minimum": 0
            },
            "RG": {
              "type": "integer",
              "minimum": 0
            },
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "K": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "content_streams": {
          "type": "object",
          "properties": {
            "streams": {
              "type": "integer",
              "minimum": 0
            },
            "decoded": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "artboard_pt": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "layers": {
          "type": "integer",
          "minimum": 0,
          "description": "optional-content groups counted from the file bytes"
        },
        "color_mode": {
          "type": "string",
          "description": "verdict from the content-stream operators (cmyk|rgb|mixed|declared-only|unknown), not from the resource dictionary"
        }
      }
    },
    "structure": {
      "type": "object",
      "description": "structural readback; keys mirror the Illustrator JSX and the vectorcraft info report",
      "properties": {
        "open_paths": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reopen_paths": {
          "type": [
            "integer",
            "null"
          ]
        },
        "layers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reopen_layers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raster": {
          "type": [
            "integer",
            "null"
          ]
        },
        "placed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "artboard": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 200x200"
        },
        "viewBox": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 0_0_200_200"
        },
        "trimmarks_ink": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "jsx_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify_yourself": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "trimmarks_ink": {
      "type": [
        "string",
        "null"
      ],
      "description": "ink of the crop marks; null where the engine draws none"
    },
    "engine": {
      "enum": [
        "illustrator",
        "vectorcraft"
      ],
      "description": "which engine produced the file"
    },
    "engine_version": {
      "type": "string",
      "description": "reported by the tool itself, never hardcoded"
    },
    "export_steps": {
      "type": "array",
      "description": "raw per-step output from the vectorcraft CLI, kept verbatim"
    },
    "source_probe": {
      "type": [
        "object",
        "null"
      ],
      "description": "what the engine said about the source before converting; null where the engine has no such phase"
    },
    "tool_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "warnings emitted by the engine during export, verbatim"
    }
  }
}
