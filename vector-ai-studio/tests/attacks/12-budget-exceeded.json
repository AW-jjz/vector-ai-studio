{
  "schema": "vector-ai-studio/attack-v1",
  "id": "12-budget-exceeded",
  "name": "generation_count 超过运行时派生的上界",
  "expect": "block",
  "why": "预算上界必须由 F.N x K_max 派生，不能自报：超界的 run 必须报错并非零退出（判决字段本身不因预算改写，所以这里断言退出码与错误码，而不是 grade）。",
  "reference": "A14 / E-BUDGET-EXCEEDED",
  "mutations": [
    {
      "op": "patch_json",
      "path": "batch.json",
      "key": "generation_count",
      "value": 99
    }
  ],
  "run": {
    "script": "aggregate_log.py",
    "args": [
      "--run-dir",
      "@RUN@",
      "--run-id",
      "attack",
      "--out",
      "@RUN@/acceptance.json"
    ]
  },
  "expect_codes": [
    "E-BUDGET-EXCEEDED"
  ],
  "expect_exit": [
    1
  ]
}
